{
  "name": "skulk-results-ledger-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Honest results ledger for Skulk harness runs. Static React site over generated run artifacts; no backend.",
  "scripts": {
    "import": "tsx scripts/import-runs.ts",
    "import:watch": "tsx scripts/watch-runs.ts",
    "publish": "tsx scripts/publish.ts",
    "dev": "vite",
    "dev:live": "concurrently -k -n import,web -c cyan,magenta \"npm:import:watch\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "postbuild": "cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
